---
import ArrowIcon from '@/components/ArrowIcon.astro';
import { TEXTS_GENERAL } from "@/lib/texts.ts";
import { SITE_DATA } from "@/lib/site.ts";
import { SITE_PAGES } from "@/lib/navigation.ts";
import { CONTACT_LINK, EXTERNAL_RESOURCES, LICENSE_LINK } from "@/lib/links.ts";
const copy = TEXTS_GENERAL.footer;
const currentYear = new Date().getFullYear();
---

<footer class="mt-16 border-t border-border/70 bg-surface">
    <div class="page-shell">
        <div
            class="grid justify-items-center gap-10 py-12 text-center lg:grid-cols-3 lg:justify-items-stretch lg:gap-12 lg:text-left"
        >
            <div class="max-w-sm">
                <a
                    href={SITE_PAGES.Home.href}
                    class="font-semibold text-primary hover:text-foreground"
                    >{SITE_DATA.name}</a
                >
                <p class="mt-2 text-sm text-muted">{copy.description}</p>
            </div>
            <div class="text-sm leading-relaxed text-muted">
                <p>{copy.disclaimer}</p>
                <p class="mt-4">
                    <a
                        href={CONTACT_LINK.href}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-link"
                    >
                        {CONTACT_LINK.label}{" "}<ArrowIcon />
                    </a>
                </p>
            </div>
            <nav aria-label={copy.externalLinks} class="text-sm">
                <h2 class="text-base font-semibold text-primary">
                    {copy.externalLinks}
                </h2>
                <ul class="mt-5 flex flex-col gap-3">
                    {
                        EXTERNAL_RESOURCES.map((resource) => (
                            <li>
                                <a
                                    href={resource.href}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="inline-flex items-baseline gap-2 leading-relaxed text-foreground hover:text-primary"
                                >
                                    {resource.label}{" "}
                                    <ArrowIcon />
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </nav>
        </div>
        <div
            class="border-t border-border py-7 text-center text-sm leading-relaxed text-foreground"
        >
            <p>
                © {currentYear}
                . {copy.independent}
            </p>
            <p>
                {copy.licenseIntro}{" "}<a
                    href={LICENSE_LINK.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="hover:text-primary transition duration-100 ease-in-out"
                    ><strong>{LICENSE_LINK.label}</strong></a
                >.
            </p>
        </div>
    </div>
</footer>
