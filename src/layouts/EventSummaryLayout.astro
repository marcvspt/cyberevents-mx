---
import BaseLayout from '@/layouts/BaseLayout.astro';
import EventVisual from '@/components/EventVisual.astro';
import { EVENT_STATUS_LABELS, formatEventDate, getCfpStatus, getEventStatus, getEventUrl, getToday, type Event } from '@/lib/event.ts';
import { TEXTS_GENERAL } from '@/lib/texts.ts';
import { SITE_PAGES } from '@/lib/data.ts';
interface Props { event: Event }
const { event } = Astro.props;
const { data } = event;
const today = getToday();
const status = getEventStatus(event, today);
const cfpStatus = getCfpStatus(event, today);
const copy = TEXTS_GENERAL.event;
const resourceLabels = copy.resourceLabels;
const location = [data.venue, data.city, data.state].filter(Boolean).join(', ') || (data.format === 'online' ? copy.formats.online : copy.locationUnknown);
const conversation = data.hashtags.length > 0
    ? data.hashtags.map((tag) => ({ term: '#' + tag, tag }))
    : [{ term: data.title, tag: undefined }];
const breadcrumbSection = status === 'finished'
    ? { href: SITE_PAGES.Archive.url, label: TEXTS_GENERAL.navigation.archive }
    : { href: SITE_PAGES.Events.url, label: TEXTS_GENERAL.navigation.events };
---
<BaseLayout title={data.title} description={data.description} canonical={getEventUrl(event)}>
    <article class="page-shell py-12 sm:py-16">
        <header class="max-w-4xl">
            <nav aria-label={copy.breadcrumbLabel} class="text-sm leading-relaxed text-muted">
                <ol class="flex flex-wrap items-center gap-x-3 gap-y-1">
                    <li><a href={SITE_PAGES.Home.url} class="hover:text-primary">{TEXTS_GENERAL.navigation.home}</a></li>
                    <li aria-hidden="true">/</li>
                    <li><a href={breadcrumbSection.href} class="hover:text-primary">{breadcrumbSection.label}</a></li>
                    <li aria-hidden="true">/</li>
                    <li aria-current="page" class="text-foreground">{data.title}</li>
                </ol>
            </nav>
            <div class="mt-6 flex flex-wrap gap-2">
                <span class="status-badge" data-status={status}><span class="size-1.5 rounded-full bg-current" aria-hidden="true"></span>{EVENT_STATUS_LABELS[status]}</span>
                {data.categories.map((category) => <span class="rounded-full border border-secondary/25 bg-secondary/8 px-3 py-1 font-mono text-[11px] text-secondary">{copy.categories[category]}</span>)}
            </div>
            <h1 class="mt-6 text-3xl font-semibold leading-tight tracking-tight sm:text-5xl">{data.title}</h1>
            <p class="mt-5 max-w-2xl text-lg leading-relaxed text-muted">{data.description}</p>
        </header>
        <div class="mt-8 grid items-start gap-8 lg:grid-cols-[minmax(0,1fr)_20rem] lg:gap-12">
            <div class="min-w-0">
                <div><EventVisual event={event} detail /></div>
                <div class="mt-10 space-y-10">
                    <section data-event-content class="prose prose-invert max-w-none text-foreground marker:text-foreground prose-headings:font-semibold prose-headings:tracking-tight prose-headings:text-foreground prose-p:text-foreground prose-li:text-foreground prose-strong:text-foreground prose-blockquote:text-foreground prose-figcaption:text-foreground prose-code:text-foreground prose-pre:text-foreground prose-th:text-foreground prose-td:text-foreground prose-a:text-primary">
                        <slot />
                    </section>
                    {data.topics.length > 0 && <section>
                        <h2 class="text-lg font-semibold">{copy.topicsTitle}</h2>
                        <ul class="mt-4 flex flex-wrap gap-2">{data.topics.map((topic) => <li class="rounded border border-border bg-surface px-3 py-1.5 font-mono text-xs text-muted">{topic}</li>)}</ul>
                    </section>}
                    {data.resources && Object.values(data.resources).some(Boolean) && <section class="border-t border-border pt-8">
                        <h2 class="text-xl font-semibold">{copy.resourcesTitle}</h2>
                        <ul class="mt-4 grid gap-3 sm:grid-cols-2">
                            {Object.entries(resourceLabels).map(([key, label]) => {
                                const url = data.resources?.[key as keyof typeof resourceLabels];
                                return url && <li><a target="_blank" rel="noopener noreferrer" href={url} class="button-secondary w-full justify-between">{label}<span aria-hidden="true">↗</span></a></li>;
                            })}
                        </ul>
                    </section>}
                </div>
                <footer class="mt-12 border-t border-border pt-6 text-xs leading-relaxed text-muted">
                    <p>{copy.updated} {formatEventDate(data.updateAt)}</p>
                    {data.verification && <>
                    <p>{copy.verificationLabels[data.verification.status]}{data.verification.checkedAt ? ' · ' + copy.checked + ' ' + formatEventDate(data.verification.checkedAt) : ''}</p>
                    </>}
                </footer>
            </div>
            <aside class="rounded-xl border border-border bg-surface p-6 lg:sticky lg:top-8 lg:max-h-[calc(100dvh-4rem)] lg:overflow-y-auto">
                <dl class="space-y-5">
                    <div><dt class="text-xs font-semibold text-muted">{copy.dateLabel}</dt><dd class="mt-2 text-sm leading-relaxed text-secondary">{data.startDate ? formatEventDate(data.startDate) : copy.dateUnknown}{data.endDate && data.endDate !== data.startDate ? ' – ' + formatEventDate(data.endDate) : ''}</dd></div>
                    <div><dt class="text-xs font-semibold text-muted">{copy.locationLabel}</dt><dd class="mt-2 text-sm leading-relaxed">{location}</dd></div>
                    <div><dt class="text-xs font-semibold text-muted">{copy.formatLabel}</dt><dd class="mt-2 text-sm">{copy.formats[data.format]}</dd></div>
                    {data.organizer && <div><dt class="text-xs font-semibold text-muted">{copy.organizer}</dt><dd class="mt-2 text-sm">{data.organizer.website ? <a target="_blank" rel="noopener noreferrer" href={data.organizer.website} class="text-link">{data.organizer.name}</a> : data.organizer.name}</dd></div>}
                </dl>
                {data.price && <p class="mt-5 border-t border-border pt-5 text-sm text-primary">{data.price.type === 'free' ? copy.free : data.price.type === 'paid' ? copy.paid + (data.price.amount !== undefined ? ': ' + data.price.amount + ' ' + data.price.currency : '') : copy.priceUnknown}</p>}
                <nav aria-label={copy.linksLabel} class="mt-6 flex flex-col gap-3">
                    {data.website && <a target="_blank" rel="noopener noreferrer" class="button-secondary" href={data.website}>{copy.official}<span aria-hidden="true">↗</span></a>}
                    {data.tickets && (status === 'upcoming' || status === 'ongoing' || status === 'coming-soon') && <a target="_blank" rel="noopener noreferrer" class="button-primary" href={data.tickets}>{copy.tickets}<span aria-hidden="true">↗</span></a>}
                    {data.cfp && cfpStatus && <a target="_blank" rel="noopener noreferrer" class="button-secondary" href={data.cfp.url}>{copy.cfp}: {copy.cfpLabels[cfpStatus]}</a>}
                </nav>
                <section id="conversation" class="mt-6 rounded-lg border border-primary/25 bg-primary/5 p-4">
                    <h2 class="text-base font-semibold">{copy.conversationTitle}</h2>
                    <p class="mt-2 text-sm leading-relaxed text-muted">{copy.conversationDescription}</p>
                    <ul class="mt-4 space-y-4">{conversation.map(({ term, tag }) => <li class="space-y-3">
                        <p class="break-words font-mono text-xs text-secondary">{term}</p>
                        <div class="grid grid-cols-2 gap-2">
                            <a target="_blank" rel="noopener noreferrer" class="button-secondary px-2 py-2 text-xs" href={'https://x.com/search?q=' + encodeURIComponent(term)}>{copy.networks.x}</a>
                            <a target="_blank" rel="noopener noreferrer" class="button-secondary px-2 py-2 text-xs" href={tag ? 'https://www.instagram.com/explore/tags/' + encodeURIComponent(tag) + '/' : 'https://www.instagram.com/explore/search/keyword/?q=' + encodeURIComponent(term)}>{copy.networks.instagram}</a>
                            <a target="_blank" rel="noopener noreferrer" class="button-secondary px-2 py-2 text-xs" href={'https://www.youtube.com/results?search_query=' + encodeURIComponent(term)}>{copy.networks.youtube}</a>
                            <a target="_blank" rel="noopener noreferrer" class="button-secondary px-2 py-2 text-xs" href={'https://www.linkedin.com/search/results/content/?keywords=' + encodeURIComponent(term)}>{copy.networks.linkedin}</a>
                        </div>
                    </li>)}</ul>
                </section>
                {data.social && Object.values(data.social).some(Boolean) && <nav aria-label={copy.socialLabel} class="mt-6 flex flex-wrap gap-4 border-t border-border pt-5 text-xs">
                    {Object.entries(data.social).map(([network, url]) => url && <a target="_blank" rel="noopener noreferrer" class="text-link" href={url}>{copy.networks[network as keyof typeof copy.networks]}</a>)}
                </nav>}
            </aside>
        </div>
    </article>
</BaseLayout>

<script>
    function prepareEventContentLinks() {
        document.querySelectorAll<HTMLAnchorElement>('[data-event-content] a[href]').forEach((link) => {
            if (!/^https?:$/.test(link.protocol) || link.origin === window.location.origin) return;
            link.target = '_blank';
            link.relList.add('noopener', 'noreferrer');
        });
    }

    prepareEventContentLinks();
    document.addEventListener('astro:page-load', prepareEventContentLinks);
</script>
