---
import ArrowIcon from '@/components/ArrowIcon.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import EventCard from '@/components/EventCard.astro';
import EventFilters from '@/components/EventFilters.astro';
import { TEXTS_GENERAL } from '@/lib/texts.ts';
import { SITE_PAGES } from '@/lib/navigation.ts';
import { getArchivedEventGroups } from '@/lib/events/content.ts';
import { matchesEventFilters, readEventFilters } from '@/lib/events/filters.ts';

const archived = await getArchivedEventGroups();
const years = archived.map(({ year }) => year);
const filters = readEventFilters(Astro.url.searchParams, years);
const hasFilters = Object.values(filters).some(Boolean);
const groups = archived
    .map(({ year, cards }) => ({ year, cards: cards.filter((card) => matchesEventFilters(card.event, filters)) }))
    .filter(({ cards }) => cards.length > 0);
const count = groups.reduce((total, group) => total + group.cards.length, 0);
const copy = TEXTS_GENERAL.archive;
const filterCopy = TEXTS_GENERAL.eventFilters;
const countLabel = hasFilters ? (count === 1 ? filterCopy.oneResult : filterCopy.results) : copy.count;
---

<BaseLayout title={SITE_PAGES.Archive.title} description={SITE_PAGES.Archive.description} canonical={SITE_PAGES.Archive.href}>
    <div class="page-shell py-14 sm:py-20">
        <header class="max-w-3xl">
            <h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">{copy.title}</h1>
            <p class="mt-5 text-base leading-relaxed text-muted">{copy.description}</p>
            <a href={SITE_PAGES.Events.href} class="button-secondary mt-6"><ArrowIcon direction="left" />{copy.back}</a>
        </header>
        <EventFilters action={SITE_PAGES.Archive.href} filters={filters} years={years} />
        <p class="mt-6 font-mono text-xs text-secondary">{count} {countLabel}</p>
        {groups.length > 0 && <nav aria-label={copy.navigation} class="mt-8 flex flex-wrap gap-2 border-b border-border pb-8">
            {groups.map((group) => <a href={'#year-' + group.year} class="button-secondary py-2 font-mono text-xs">{group.year}<span class="text-secondary">{group.cards.length}</span></a>)}
        </nav>}
        {groups.length === 0 && <p class="mt-4 rounded-xl border border-border bg-surface p-6 text-muted">{hasFilters ? filterCopy.empty : copy.empty}</p>}
        <div class="space-y-14 pt-10">
            {groups.map((group) => <section id={'year-' + group.year}>
                <div class="mb-6 flex items-center gap-4">
                    <span aria-hidden="true" class="h-8 w-0.5 bg-linear-to-b from-primary to-secondary"></span>
                    <h2 class="font-mono text-2xl font-semibold">{group.year}</h2>
                    <span class="text-xs text-muted">{group.cards.length} {copy.yearCount}</span>
                </div>
                <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">{group.cards.map((card) => <EventCard card={card} />)}</div>
            </section>)}
        </div>
    </div>
</BaseLayout>
