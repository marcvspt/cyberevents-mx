---
import { render } from "astro:content";
import EventSummaryLayout from "@/layouts/EventSummaryLayout.astro";
import { getPublishedEvent } from "@/lib/events/content.ts";

const event = await getPublishedEvent(Astro.params.slug);
if (!event) return Astro.rewrite('/404');
const { Content } = await render(event);
---

<EventSummaryLayout event={event}>
  <Content />
</EventSummaryLayout>
